# Carte figée 19 sept — modèles locaux Hyper Ambient 0.1.
# Aucun secret. Source de vérité pour le host-agent (charger_carte_figee)
# et pour relance_hostagent.sh. Écrase router / Qwen3 / Supertonic.
# Désactiver : CARTE_FIGEE=0. Forcer une clé : MOUTH_DEVICE_FORCE=cpu.
# EN 0.1 : HA_LANG=en (UI / prompt / nombres). La carte locale reste FR.

BRAIN_SERVICE=router
BRAIN_MODEL=MiniMaxAI/MiniMax-M3
BRAIN_MODEL_LOCAL=mother-local
MODEL=/workspace/models/gguf/granite-4.2-3b-Q4_K_M.gguf

EARS_BACKEND=faster-whisper
EARS_MODEL=large-v3
EARS_LANGUAGE=fr
EARS_DEVICE=cuda
EARS_COMPUTE_TYPE=int8_float16
EARS_HOTWORDS=Hyper Ambient

MOUTH_BACKEND=magpie
MOUTH_VOICE_NAME=Sofia
MOUTH_LANGUAGE=fr
MOUTH_DEVICE=cuda
MOUTH_OUTPUT_GAIN_DB=9
