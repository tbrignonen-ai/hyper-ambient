# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.

# ---------------------------------------------------------------------------
# Modèles : la source de vérité est dev/scripts/carte_figee.env. Le host-agent
# la charge au boot et elle écrase les clés modèle ci-dessous (CARTE_FIGEE=0
# pour la désactiver). Les valeurs ici la recopient ; dev/tests/
# test_carte_figee_docs.py échoue si elles divergent.
#
# BRAIN — which backend answers.
#   router   : local reflex (Granite 4.2 3B, llama-server) + remote deep tier
#              (MiniMax-M3); a local classifier decides each turn. Default.
#   llamacpp : local llama-server only, GGUF on CUDA (no key needed)
#   openai   : any other OpenAI-compatible endpoint
#   stepfun  : retired (the account answers HTTP 402), kept for history
# All of them speak /v1/chat/completions, so switching is config-only.
# ---------------------------------------------------------------------------
BRAIN_SERVICE=router

# Remote backend (deep tier of the router). The endpoint and key belong to the
# account holder: fill them in .env.local, never here.
BRAIN_API_KEY=
BRAIN_API_ENDPOINT=
BRAIN_MODEL=MiniMaxAI/MiniMax-M3
BRAIN_TIMEOUT_MS=30000

# Recherche web sans cle depuis mother-core-dev (SearXNG publie sur l'hote).
SEARXNG_URL=http://host.docker.internal:8080
# Replis web optionnels : laisser vides tant qu'aucune cle n'est provisionnee.
# Ordre : ddgs (paquet optionnel), Tavily, Brave, Exa, Jina, Serper.
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
SERPER_API_KEY=

# Ponts agents optionnels exposes a la voix. Les services tournent sur l'hote ;
# le host-agent tourne dans mother-core-dev et passe par host.docker.internal.
# Un outil reste absent du registre si son URL/jeton requis est vide.
CODEX_BRIDGE_URL=http://host.docker.internal:8765/ask
CODEX_BRIDGE_TOKEN=
CLI_BRIDGE_URL=http://host.docker.internal:8766/ask
CLI_BRIDGE_TOKEN=
MUSE_BRIDGE_URL=

# Local llama.cpp backend (used directly, or as automatic fallback)
LLAMA_SERVER_HOST=http://localhost:8080
BRAIN_MODEL_LOCAL=mother-local
MODEL=/workspace/models/gguf/granite-4.2-3b-Q4_K_M.gguf
ALIAS=mother-local
CTX=4096

# Language of the spoken UI / prompts / number normalisation.
# fr = default. en or en-US switches English 0.1. Anything else falls back to fr.
# HA_LANG=fr
# HYPER_AMBIENT_LANG=fr
HF_HOME=/workspace/models/hf-cache
HF_HUB_OFFLINE=1
EARS_BACKEND=faster-whisper
EARS_MODEL=large-v3
EARS_LANGUAGE=fr
EARS_DEVICE=cuda
EARS_COMPUTE_TYPE=int8_float16
EARS_HOTWORDS=Hyper Ambient
TURN_SILENCE_MS=700
MOUTH_BACKEND=magpie
MOUTH_VOICE_NAME=Sofia
MOUTH_LANGUAGE=fr
MOUTH_DEVICE=cuda
# Gain final commun a Presence/Talk, avec limiteur doux anti-saturation.
MOUTH_OUTPUT_GAIN_DB=9
# Anciennes cartes, gardees comme replis (historique, plus le defaut) :
# EARS_BACKEND=qwen3 / EARS_MODEL=0.6B, ou faster-whisper large-v3-turbo.
# MOUTH_BACKEND=pocket / MOUTH_VOICE_NAME=estelle / MOUTH_LANGUAGE=french_24l
# MOUTH_VOICE=/workspace/models/piper/fr_FR-tom-medium.onnx   (MOUTH_BACKEND=piper)

# Optional remote MOUTH (/audio/speech compatible). Keep MOUTH_BACKEND local
# until the host-agent selector is connected; no remote key is mandatory.
# MOUTH_BACKEND=remote
# MOUTH_REMOTE_BASE_URL=https://api.example/v1   (StepFun, l'ancien fournisseur, est retire : 402)
# MOUTH_REMOTE_API_KEY=
# MOUTH_REMOTE_MODEL=
# MOUTH_REMOTE_VOICE=
# MOUTH_REMOTE_TIMEOUT_S=30
# Provider-specific overrides (defaults shown):
# MOUTH_REMOTE_AUTH_PATH=models
# MOUTH_REMOTE_VOICES_PATH=audio/voices
# MOUTH_REMOTE_SPEECH_PATH=audio/speech

# ---------------------------------------------------------------------------
# Other services (optional)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Distant visual presence (optional, not day-1). wan2.7-image is DashScope-only:
# no local checkpoint. Singapore = default for EU. Beijing = 50 free images / 90 days.
# DASHSCOPE_API_KEY=
# DASHSCOPE_REGION=singapore
